{
  "name": "codebox-day-1",
  "version": "1.0.0",
  "description": "Tally: a to-do app with a React client and an Express + Supabase API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -n api,web -c yellow,cyan \"npm run dev\" \"npm run dev:client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "token": "node scripts/generate-token.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbautista2005/codebox-day-1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rbautista2005/codebox-day-1/issues"
  },
  "homepage": "https://github.com/rbautista2005/codebox-day-1#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
