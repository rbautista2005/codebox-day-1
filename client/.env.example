# Supabase → Project Settings → API. These are safe to ship to the browser:
# the anon (publishable) key only does what Row Level Security allows.
# NEVER put the service role key here — anything prefixed VITE_ is public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me-with-your-anon-key
